{
  "name": "dsh-plugin-system-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Loader 双面插件：会话头部实时显示宿主 CPU/内存(及 GPU 型号) 监控徽标（System Monitor），持久化自动装载。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
